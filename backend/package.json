{
  "name": "stockpile-backend",
  "version": "1.0.0",
  "description": "StockPile inventory API (Express + PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1"
  }
}
